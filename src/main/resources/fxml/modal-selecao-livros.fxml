<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.diagonal.cordeis.controller.ModalSelecaoLivrosController">
    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: #9C27B0; -fx-padding: 16 24;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <FontAwesomeIconView fill="white" glyphName="CHECK_SQUARE_O" size="20" />
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Selecionar Livros para a Coleção" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="labelNomeColecao" style="-fx-font-size: 12px; -fx-text-fill: #E1BEE7; -fx-font-style: italic;" />
            </HBox>
        </VBox>
    </top>
    <!-- CONTENT -->
    <center>
        <VBox spacing="16" style="-fx-padding: 24 20 20 20;">
            <!-- FILTROS E BUSCA -->
            <HBox spacing="15" style="-fx-background-color: #FAFAFA; -fx-padding: 14; -fx-background-radius: 10;">
                <!-- ESQUERDA: Campo de busca -->
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                    <FontAwesomeIconView fill="#666" glyphName="FILTER" size="14" />
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #666;" text="Filtros:" />
                    <TextField fx:id="campoBuscaModal" prefWidth="260" promptText="🔍 Buscar por título ou SKU..." style="-fx-background-radius: 15; -fx-padding: 6 12; -fx-font-size: 12px;" />
                   <!-- DIREITA: Filtro por tipo e contador -->
                   <HBox alignment="CENTER_RIGHT" spacing="10">
                       <ComboBox fx:id="comboFiltroTipo" prefWidth="140" promptText="Tipo de Livro" style="-fx-background-radius: 6;" />
                       <Label fx:id="labelContadorFiltrados" style="-fx-background-color: #E3F2FD; -fx-text-fill: #1976D2; -fx-padding: 4 10; -fx-background-radius: 6; -fx-font-size: 11px; -fx-font-weight: bold;" text="0 livros" />
                   </HBox>
                </HBox>
            </HBox>
            <!-- ÁREA DE SELEÇÃO -->
            <HBox spacing="15" VBox.vgrow="ALWAYS">
                <!-- LIVROS DISPONÍVEIS -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="550">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontAwesomeIconView fill="#666" glyphName="LIST" size="14" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-font-weight: bold;" text="Livros Disponíveis" />
                        <Label fx:id="labelTotalDisponiveis" style="-fx-font-size: 12px; -fx-text-fill: #999;" text="(0)" />
                    </HBox>
                    <TableView fx:id="tabelaLivrosDisponiveis" style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSelecionar" minWidth="40.0" prefWidth="60.0" text="Selecionar" />
                            <TableColumn fx:id="colSku" minWidth="80" prefWidth="120" text="SKU" />
                            <TableColumn fx:id="colTitulo" minWidth="200" prefWidth="300" text="Título" />
                            <TableColumn fx:id="colTipo" minWidth="60" prefWidth="80" text="Tipo" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                                <FontAwesomeIconView fill="#bbb" glyphName="SEARCH" size="24" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #aaa;" text="Nenhum livro encontrado" />
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
                <!-- LIVROS SELECIONADOS -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="320">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontAwesomeIconView fill="#4CAF50" glyphName="CHECK_CIRCLE" size="14" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-font-weight: bold;" text="Livros Selecionados" />
                        <Label fx:id="labelContadorSelecionados" style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-padding: 3 8; -fx-background-radius: 10; -fx-font-size: 12px; -fx-font-weight: bold;" text="0" />
                    </HBox>
                    <ListView fx:id="listSelecionados" style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                                <FontAwesomeIconView fill="#bbb" glyphName="PLUS_CIRCLE" size="24" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #aaa;" text="Nenhum livro selecionado" />
                            </VBox>
                        </placeholder>
                    </ListView>
                </VBox>
            </HBox>
        </VBox>
    </center>
    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-background-color: #F8F9FA; -fx-padding: 15 24; -fx-border-color: #E0E0E0; -fx-border-width: 1 0 0 0;">
            <Label style="-fx-font-size: 11px; -fx-text-fill: #666; -fx-font-style: italic;" text="💡 Dica: Marque ou desmarque os checkboxes para selecionar livros" />
            <Label style="-fx-font-size: 11px; -fx-text-fill: #666; -fx-font-style: italic;" text="🔄 Clique duplo em um item da lista para removê-lo" />
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCancelar" onAction="#cancelar" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 20; -fx-font-size: 13px;" text="✖ Cancelar" />
            <Button fx:id="btnConfirmar" onAction="#confirmar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 20; -fx-font-size: 13px; -fx-font-weight: bold;" text="✓ Confirmar Seleção" />
        </HBox>
    </bottom>
</BorderPane>