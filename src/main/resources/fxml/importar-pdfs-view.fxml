<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.diagonal.cordeis.controller.ImportarArquivosController"
            prefWidth="800" prefHeight="650">
    
    <!-- HEADER SECTION -->
    <top>
        <VBox>
            <ToolBar style="-fx-background-color: none; -fx-padding: 10;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontAwesomeIconView glyphName="DOWNLOAD" size="20" fill="#FF9800"/>
                    <Label text="Importação de PDFs" 
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Importação em lote • Livros com capa integrada" 
                       style="-fx-font-size: 11px; -fx-text-fill: #666; -fx-font-style: italic;"/>
            </ToolBar>
            
            <!-- INFO BANNER -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 15 5 15; -fx-background-color: #E8F5E8; -fx-border-color: #4CAF50; -fx-border-width: 0 0 0 3;">
                <FontAwesomeIconView glyphName="MAGIC" size="12" fill="#4CAF50"/>
                <Label text="Importe múltiplos PDFs de uma só vez • Sistema detecta automaticamente as informações" 
                       style="-fx-font-size: 11px; -fx-text-fill: #2E7D32;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            
            <!-- CONFIGURATION PANEL -->
            <VBox spacing="15" 
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 20;">
                
                <!-- PANEL HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontAwesomeIconView glyphName="COG" size="16" fill="#FF9800"/>
                    <Label text="Configuração da Importação" 
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                </HBox>
                
                <!-- CONFIGURATION FORM -->
                <HBox spacing="30">
                    
                    <!-- DIRECTORY SELECTION -->
                    <VBox spacing="8" prefWidth="400">
                        <Label text="Pasta com arquivos PDF" 
                               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                        <HBox spacing="8">
                            <TextField fx:id="diretorioField" HBox.hgrow="ALWAYS" prefHeight="35"
                                       promptText="📁 Selecione a pasta com os PDFs..."
                                       editable="false"
                                       style="-fx-background-radius: 5; -fx-border-radius: 5;"/>
                            <Button onAction="#escolherDiretorio" prefHeight="35"
                                    style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;">
                                <graphic>
                                    <FontAwesomeIconView glyphName="FOLDER_OPEN" size="14"/>
                                </graphic>
                                <tooltip>
                                    <Tooltip text="Escolher pasta"/>
                                </tooltip>
                            </Button>
                        </HBox>
                        <Label text="🔍 Buscaremos por arquivos .pdf na pasta selecionada" 
                               style="-fx-font-size: 10px; -fx-text-fill: #999;"/>
                    </VBox>
                    
                    <!-- AUTOMATIC DETECTION INFO -->
                    <VBox spacing="8" minWidth="220" prefWidth="290">
                        <Label text="Detecção Automática" 
                               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                        <VBox spacing="5" style="-fx-background-color: #E8F5E8; -fx-background-radius: 5; -fx-padding: 10; -fx-border-color: #4CAF50; -fx-border-width: 0 0 0 3;">
                            <Label text="🤖 SKU e Tipo detectados automaticamente" 
                                   style="-fx-font-size: 11px; -fx-text-fill: #2E7D32; -fx-font-weight: bold;"/>
                            <Label text="• MC#### → Mini Cordel" 
                                   style="-fx-font-size: 10px; -fx-text-fill: #2E7D32;"/>
                            <Label text="• FC#### → Folheto Cordel" 
                                   style="-fx-font-size: 10px; -fx-text-fill: #2E7D32;"/>
                        </VBox>
                        <Label text="📋 Sistema identifica pelo nome do arquivo" 
                               style="-fx-font-size: 10px; -fx-text-fill: #999;"/>
                    </VBox>
                </HBox>
                
                <!-- RESULTS SUMMARY -->
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #f5f5f5; -fx-background-radius: 5; -fx-padding: 10;">
                    <FontAwesomeIconView glyphName="INFO_CIRCLE" size="12" fill="#666"/>
                    <Label fx:id="labelResumo" text="0 arquivos encontrados" 
                           style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
            
            <!-- FILES PREVIEW TABLE -->
            <VBox spacing="10" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 20;">
                
                <!-- TABLE HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontAwesomeIconView glyphName="LIST" size="16" fill="#666"/>
                    <Label text="Arquivos Encontrados" 
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="💡 Você pode editar os títulos clicando duas vezes" 
                           style="-fx-font-size: 10px; -fx-text-fill: #999; -fx-font-style: italic;"/>
                </HBox>
                
                <!-- BARRA DE BUSCA -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="search-container">
                    <FontAwesomeIconView glyphName="SEARCH" size="14" fill="#666"/>
                    <TextField fx:id="campoBuscaArquivos" 
                               promptText="🔍 Buscar por título, caminho ou tipo de arquivo..." 
                               prefWidth="350" 
                               styleClass="table-search-field"
                               HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnLimparBuscaArquivos" 
                            text="✖" 
                            styleClass="clear-search-button"
                            >
                        <tooltip>
                            <Tooltip text="Limpar busca"/>
                        </tooltip>
                    </Button>
                    <Label fx:id="labelResultadosArquivos" 
                           text="0 resultados" 
                           styleClass="results-counter"/>
                </HBox>
                
                <!-- FILES TABLE -->
                <TableView fx:id="tabelaArquivos" editable="true" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 5; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="colTitulo" text="📚 Título do Livro" prefWidth="350"/>
                        <TableColumn fx:id="colCaminho" text="📁 Caminho do Arquivo" prefWidth="300"/>
                        <TableColumn fx:id="colTipo" text="🏷️ Tipo" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                            <FontAwesomeIconView glyphName="FOLDER_OPEN_O" size="48" fill="#ccc"/>
                            <Label text="Nenhum arquivo encontrado" 
                                   style="-fx-font-size: 14px; -fx-text-fill: #999;"/>
                            <Label text="Selecione uma pasta com arquivos PDF" 
                                   style="-fx-font-size: 11px; -fx-text-fill: #ccc;"/>
                        </VBox>
                    </placeholder>
                </TableView>
                
                <!-- ACTION BUTTONS -->
                <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-background-color: #f9f9f9; -fx-background-radius: 5; -fx-padding: 15;">
                    
                    <!-- INFO BUTTON -->
                    <Button fx:id="btnVincularCapasEmLote" text="Como Funciona" onAction="#mostrarInformacoesSistema"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;">
                        <graphic>
                            <FontAwesomeIconView glyphName="INFO_CIRCLE" size="14" fill="white"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Abrir instruções detalhadas sobre o sistema"/>
                        </tooltip>
                    </Button>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <!-- MAIN ACTIONS -->
                    <Button text="Limpar" onAction="#cancelarImportacao"
                            style="-fx-background-color: #757575; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;">
                        <graphic>
                            <FontAwesomeIconView glyphName="ERASER" size="14" fill="white"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Limpar formulário"/>
                        </tooltip>
                    </Button>
                    
                    <Button text="Importar Livros" onAction="#confirmarImportacao"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-padding: 8 20;">
                        <graphic>
                            <FontAwesomeIconView glyphName="DOWNLOAD" size="14" fill="white"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Importar todos os livros listados"/>
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>
    
    <!-- FOOTER HELP -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
            <Label text="🎯 Processo: Selecionar pasta → Revisar títulos → Importar" 
                   style="-fx-font-size: 11px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
            <Separator orientation="VERTICAL"/>
            <Label text="📋 Dica: Organize os PDFs em pastas separadas por categoria" 
                   style="-fx-font-size: 10px; -fx-text-fill: #999;"/>
        </HBox>
    </bottom>
</BorderPane>
