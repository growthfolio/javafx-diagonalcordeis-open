<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<StackPane style="-fx-background-color: linear-gradient(to bottom right, #f8fafc, #e2e8f0);" 
           xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.diagonal.cordeis.controller.LoginController" 
           stylesheets="@../css/auth-styles.css,@../css/modern-auth.css,@../css/auth-modal.css"
           styleClass="auth-modal-root">
    
    <!-- Container principal centralizado -->
    <VBox alignment="CENTER" maxWidth="350" spacing="8" styleClass="modern-auth-container,auth-form-container"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 32; 
                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12;">
        <effect>
            <DropShadow color="#00000015" radius="20" spread="0.0" offsetY="2" />
        </effect>

        <!-- Botão de fechar discreto -->
        <HBox alignment="TOP_RIGHT" spacing="0" maxWidth="Infinity" style="-fx-padding: -8 -8 0 0;">
            <Button onAction="#handleCloseWindow" 
                    style="-fx-background-color: transparent; -fx-padding: 4; -fx-cursor: hand; 
                           -fx-background-radius: 20; -fx-border-radius: 20;">
                <graphic>
                    <FontAwesomeIconView glyphName="TIMES" size="14" style="-fx-fill: #94a3b8;" />
                </graphic>
            </Button>
        </HBox>
        <!-- Cabeçalho modernizado -->
        <VBox alignment="CENTER" spacing="6" maxWidth="Infinity" style="-fx-padding: 0 0 20 0;">
            <Label text="Diagonal Cordéis" 
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;" />
            <Label text="Bem-vindo de volta" 
                   style="-fx-font-size: 18px; -fx-font-weight: 500; -fx-text-fill: #1e293b;" />
            <Label text="Entre na sua conta para continuar" 
                   style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
        </VBox>

        <!-- Formulário modernizado -->
        <VBox spacing="12" alignment="CENTER_LEFT" maxWidth="Infinity">
            <!-- Campo Usuário -->
            <VBox spacing="6" alignment="CENTER_LEFT" maxWidth="Infinity">
                <Label text="Nome de usuário" 
                       style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;"/>
                <HBox alignment="CENTER_LEFT" spacing="8" maxWidth="Infinity"
                      style="-fx-background-color: #f8fafc; -fx-background-radius: 8; 
                             -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 2; 
                             -fx-padding: 12;">
                    <FontAwesomeIconView glyphName="USER" size="16" style="-fx-fill: #64748b;" />
                    <TextField fx:id="usernameField" promptText="Digite seu nome de usuário" 
                              style="-fx-background-color: transparent; -fx-padding: 0; 
                                     -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8;" 
                              maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                </HBox>
                <Label fx:id="usernameError" managed="false" visible="false"
                       style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-padding: 0 4;" />
            </VBox>

            <!-- Campo Senha -->
            <VBox spacing="6" alignment="CENTER_LEFT" maxWidth="Infinity">
                <Label text="Senha" 
                       style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;"/>
                <HBox alignment="CENTER_LEFT" spacing="8" maxWidth="Infinity"
                      style="-fx-background-color: #f8fafc; -fx-background-radius: 8; 
                             -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 2; 
                             -fx-padding: 12;">
                    <FontAwesomeIconView glyphName="LOCK" size="16" style="-fx-fill: #64748b;" />
                    <PasswordField fx:id="passwordField" onKeyPressed="#handleEnterKey" 
                                  promptText="Digite sua senha" 
                                  style="-fx-background-color: transparent; -fx-padding: 0; 
                                         -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8;" 
                                  maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="passwordError" managed="false" visible="false"
                       style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-padding: 0 4;" />
            </VBox>

            <!-- Opções auxiliares -->
            <HBox alignment="CENTER_LEFT" spacing="8" maxWidth="Infinity" style="-fx-padding: 4 0;">
                <CheckBox fx:id="rememberMeCheckbox" text="Lembrar-me" 
                          style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
                <Region HBox.hgrow="ALWAYS" />
                <Hyperlink onAction="#handleForgotPassword" text="Esqueceu a senha?" 
                           style="-fx-text-fill: #4f46e5; -fx-underline: false; -fx-font-size: 13px; 
                                  -fx-font-weight: 500;" />
            </HBox>

            <!-- Mensagem de erro modernizada -->
            <VBox fx:id="errorContainer" managed="false" visible="false" maxWidth="Infinity" 
                  style="-fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-padding: 12; 
                         -fx-border-color: #fecaca; -fx-border-width: 1; -fx-border-radius: 8;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontAwesomeIconView glyphName="EXCLAMATION_TRIANGLE" size="14" style="-fx-fill: #ef4444;" />
                    <Label fx:id="errorLabel" wrapText="true" 
                           style="-fx-text-fill: #dc2626; -fx-font-size: 13px;" />
                </HBox>
            </VBox>

            <!-- Botão Entrar modernizado -->
            <Button defaultButton="true" maxWidth="Infinity" onAction="#handleLogin"
                    style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; 
                           -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 8; 
                           -fx-border-radius: 8; -fx-cursor: hand;">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <FontAwesomeIconView glyphName="SIGN_IN" size="16" style="-fx-fill: white;" />
                        <Label text="Entrar" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" />
                    </HBox>
                </graphic>
            </Button>

            <!-- Link Cadastro centralizado -->
            <HBox alignment="CENTER" spacing="6" maxWidth="Infinity" style="-fx-padding: 16 0 0 0;">
                <Label text="Não tem uma conta?" 
                       style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                <Hyperlink onAction="#handleRegisterLink" text="Cadastre-se" 
                           style="-fx-text-fill: #4f46e5; -fx-underline: false; -fx-font-weight: 600; 
                                  -fx-font-size: 14px;" />
            </HBox>
        </VBox>

    </VBox>
</StackPane>
