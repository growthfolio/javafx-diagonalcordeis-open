<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.diagonal.cordeis.controller.LivroController">
    
    <!-- HEADER SECTION -->
    <top>
        <VBox>
            <ToolBar style="-fx-background-color: none; -fx-padding: 10;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontAwesomeIconView glyphName="BOOK" size="20" fill="#4CAF50"/>
                    <Label text="Gerenciar Livros" 
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Biblioteca de livros com capa integrada" 
                       style="-fx-font-size: 11px; -fx-text-fill: #666; -fx-font-style: italic;"/>
            </ToolBar>
            
            <!-- HELP BANNER -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 15 5 15; -fx-background-color: #FFF3E0; -fx-border-color: #FF9800; -fx-border-width: 0 0 0 3;">
                <FontAwesomeIconView glyphName="INFO" size="12" fill="#F57C00"/>
                <Label text="Certifique-se de que os PDFs possuem a capa na primeira página" 
                       style="-fx-font-size: 11px; -fx-text-fill: #E65100;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">
            
            <!-- LEFT PANEL: FORM -->
            <VBox spacing="20" prefWidth="400" 
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 20;">
                
                <!-- FORM HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontAwesomeIconView glyphName="PLUS_CIRCLE" size="16" fill="#4CAF50"/>
                    <Label text="Cadastro de Livro" 
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                </HBox>
                
                <!-- FORM FIELDS -->
                <VBox spacing="15">
                    
                    <!-- SKU (READ-ONLY) -->
                    <VBox spacing="5">
                        <Label text="SKU (Código único)" 
                               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                        <TextField fx:id="skuField" 
                                   prefWidth="360" prefHeight="35"
                                   promptText="Será gerado automaticamente (MC#### ou FC####)"
                                   editable="false"
                                   style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-background-color: #f5f5f5;"/>
                        <Label text="🔢 Gerado automaticamente com base no nome do arquivo" 
                               style="-fx-font-size: 10px; -fx-text-fill: #999;"/>
                    </VBox>
                    
                    <!-- TÍTULO -->
                    <VBox spacing="5">
                        <Label text="Título do Livro" 
                               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                        <TextField fx:id="tituloField" 
                                   prefWidth="360" prefHeight="35"
                                   promptText="Extraído automaticamente do nome do arquivo..."
                                   style="-fx-background-radius: 5; -fx-border-radius: 5;"/>
                        <Label text="📝 Será extraído automaticamente, mas você pode editar" 
                               style="-fx-font-size: 10px; -fx-text-fill: #999;"/>
                    </VBox>
                    
                    <!-- ARQUIVO PDF -->
                    <VBox spacing="5">
                        <Label text="Arquivo PDF (com capa integrada)" 
                               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                        <HBox spacing="8">
                            <TextField fx:id="caminhoPdfField" 
                                       prefWidth="280" prefHeight="35"
                                       promptText="Selecione o arquivo PDF..." 
                                       editable="false"
                                       style="-fx-background-radius: 5; -fx-border-radius: 5;"/>
                            <Button onAction="#escolherArquivo" prefHeight="35"
                                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;">
                                <graphic>
                                    <FontAwesomeIconView glyphName="FOLDER_OPEN" size="14"/>
                                </graphic>
                                <tooltip>
                                    <Tooltip text="Selecionar arquivo PDF"/>
                                </tooltip>
                            </Button>
                        </HBox>
                        <Label text="📄 O PDF deve conter a capa na primeira página" 
                               style="-fx-font-size: 10px; -fx-text-fill: #999;"/>
                    </VBox>
                    
                    <!-- TIPO (READ-ONLY) -->
                    <VBox spacing="5">
                        <Label text="Tipo do Livro" 
                               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                        <ComboBox fx:id="comboTipo" prefWidth="200" prefHeight="35"
                                  disable="true"
                                  style="-fx-background-radius: 5; -fx-background-color: #f5f5f5;"/>
                        <Label text="🏷️ Definido automaticamente: MC = Mini, FC = Normal" 
                               style="-fx-font-size: 10px; -fx-text-fill: #999;"/>
                    </VBox>
                </VBox>
                
                <!-- ACTION BUTTONS -->
                <VBox spacing="10">
                    <Separator/>
                    
                    <!-- PRIMARY ACTIONS -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Salvar" onAction="#salvarLivro" 
                                prefWidth="120" prefHeight="35"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
                            <graphic>
                                <FontAwesomeIconView glyphName="FLOPPY_O" size="14" fill="white"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Salvar novo livro ou atualizar selecionado"/>
                            </tooltip>
                        </Button>
                        
                        <Button text="Excluir" onAction="#excluirLivro" 
                                prefWidth="120" prefHeight="35"
                                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
                            <graphic>
                                <FontAwesomeIconView glyphName="TRASH" size="14" fill="white"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Excluir livro selecionado"/>
                            </tooltip>
                        </Button>
                        
                        <Button text="Limpar" onAction="#limparFormulario" 
                                prefWidth="100" prefHeight="35"
                                style="-fx-background-color: #757575; -fx-text-fill: white; -fx-background-radius: 5;">
                            <graphic>
                                <FontAwesomeIconView glyphName="ERASER" size="14" fill="white"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Limpar formulário"/>
                            </tooltip>
                        </Button>
                    </HBox>
                    
                    <!-- HELP TEXT -->
                    <VBox spacing="5" style="-fx-background-color: #f0f7ff; -fx-background-radius: 5; -fx-padding: 10;">
                        <Label text="🤖 Processo automático:" 
                               style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #1976D2;"/>
                        <Label text="• SKU e tipo são extraídos do nome do arquivo" 
                               style="-fx-font-size: 10px; -fx-text-fill: #424242;"/>
                        <Label text="• MC#### = Mini Cordel, FC#### = Folheto Cordel" 
                               style="-fx-font-size: 10px; -fx-text-fill: #424242;"/>
                        <Label text="• Título é limpo automaticamente" 
                               style="-fx-font-size: 10px; -fx-text-fill: #424242;"/>
                    </VBox>
                </VBox>
            </VBox>
            
            <!-- RIGHT PANEL: TABLE -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            <VBox>
               <children>
                      <!-- TABLE HEADER -->
                      <HBox alignment="CENTER_LEFT" spacing="8" />
                      <!-- BARRA DE BUSCA -->
                      <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-container">
                     <VBox>
                        <children>
                           <ToolBar style="-fx-background-color: transparent;">
                              <items>
                                      <FontAwesomeIconView fill="#666" glyphName="LIST" size="16" />
                                      <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Biblioteca de Livros" />
                                      <Region prefHeight="24.0" prefWidth="60.0" />
                              </items>
                           </ToolBar>
                           <ToolBar style="-fx-background-color: transparent;">
                              <items>
                                      <FontAwesomeIconView fill="#666" glyphName="SEARCH" size="14" />
                                      <TextField fx:id="campoBuscaLivros" prefHeight="26.0" prefWidth="315.0" promptText="Buscar por título, SKU ou tipo de livro..." styleClass="table-search-field" />
                                      <Button fx:id="btnLimparBuscaLivros" onAction="#limparBuscaLivros" styleClass="clear-search-button" text="✖">
                                          <tooltip>
                                              <Tooltip text="Limpar busca" />
                                          </tooltip>
                                      </Button>
                                      <Label fx:id="labelResultadosLivros" styleClass="results-counter" text="0 resultados" />
                              </items>
                           </ToolBar>
                        </children>
                     </VBox>
                      </HBox>
               </children>
            </VBox>
                
                <!-- TABLE -->
                <TableView fx:id="tabelaLivros" style="-fx-background-radius: 5; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSku" prefWidth="100" text="SKU" />
                        <TableColumn fx:id="colTitulo" prefWidth="200" text="Título" />
                        <TableColumn fx:id="colArquivo" prefWidth="150" text="Arquivo PDF" />
                        <TableColumn fx:id="colPaginas" prefWidth="80" text="Páginas" />
                        <TableColumn fx:id="colTipo" prefWidth="80" text="Tipo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                            <FontAwesomeIconView glyphName="BOOK" size="48" fill="#ccc"/>
                            <Label text="Nenhum livro cadastrado" 
                                   style="-fx-font-size: 14px; -fx-text-fill: #999;"/>
                            <Label text="Adicione o primeiro livro usando o formulário ao lado" 
                                   style="-fx-font-size: 11px; -fx-text-fill: #ccc;"/>
                        </VBox>
                    </placeholder>
                </TableView>
                
                <!-- TABLE FOOTER INFO -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f9f9f9; -fx-background-radius: 5; -fx-padding: 8;">
                    <FontAwesomeIconView glyphName="INFO_CIRCLE" size="12" fill="#666"/>
                    <Label text="Clique em uma linha para editar • Duplo clique no título/SKU para editar diretamente • Duplo clique para visualizar o PDF" 
                           style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
