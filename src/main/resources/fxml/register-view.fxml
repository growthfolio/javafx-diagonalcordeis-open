<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<StackPane style="-fx-background-color: linear-gradient(to bottom right, #f8fafc, #e2e8f0);"
           stylesheets="@../css/auth-styles.css,@../css/modern-auth.css,@../css/password-strength.css,@../css/auth-modal.css"
           xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.diagonal.cordeis.controller.RegisterController"
           styleClass="auth-modal-root">

    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;"
                vbarPolicy="AS_NEEDED" styleClass="auth-modal-scroll">
        <content>
            <!-- Container principal centralizado -->
            <StackPane alignment="CENTER" styleClass="auth-modal-center">
                <VBox alignment="CENTER" maxWidth="420" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 32;                     -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12;"
                      styleClass="modern-auth-container,auth-form-container">

                    <effect>
                        <DropShadow color="#00000015" offsetY="2" radius="20" spread="0.0"/>
                    </effect>

                    <!-- Botão de fechar discreto -->
                    <HBox alignment="TOP_RIGHT" maxWidth="Infinity" spacing="0" style="-fx-padding: -8 -8 0 0;">
                        <Button onAction="#handleCloseWindow"
                                style="-fx-background-color: transparent; -fx-padding: 4; -fx-cursor: hand; -fx-background-radius: 20; -fx-border-radius: 20;">
                            <graphic>
                                <FontAwesomeIconView glyphName="TIMES" size="14" style="-fx-fill: #94a3b8;"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- Cabeçalho modernizado -->
                    <VBox alignment="CENTER" maxWidth="Infinity" spacing="6" style="-fx-padding: 0 0 20 0;">
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"
                               text="Diagonal Cordéis"/>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: 500; -fx-text-fill: #1e293b;"
                               text="Criar Nova Conta"/>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;"
                               text="Preencha os dados para começar"/>
                    </VBox>

                    <!-- Formulário modernizado -->
                    <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
                        <!-- Nome Completo -->
                        <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="6">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;"
                                   text="Nome Completo"/>
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 8;                               -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 2;                               -fx-padding: 12;">
                                <FontAwesomeIconView glyphName="USER" size="16" style="-fx-fill: #64748b;"/>
                                <TextField fx:id="nomeField" maxWidth="Infinity" promptText="Digite seu nome completo"
                                           style="-fx-background-color: transparent; -fx-padding: 0;                                        -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8;"
                                           HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Label fx:id="nomeErrorLabel" managed="false"
                                   style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-padding: 0 4;"
                                   visible="false"/>
                        </VBox>

                        <!-- Nome de Usuário -->
                        <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="6">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;"
                                   text="Nome de Usuário"/>
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 8;                               -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 2;                               -fx-padding: 12;">
                                <FontAwesomeIconView glyphName="USER_CIRCLE" size="16" style="-fx-fill: #64748b;"/>
                                <TextField fx:id="usernameField" maxWidth="Infinity"
                                           promptText="Escolha um nome de usuário"
                                           style="-fx-background-color: transparent; -fx-padding: 0;                                        -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8;"
                                           HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Label fx:id="usernameErrorLabel" managed="false"
                                   style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-padding: 0 4;"
                                   visible="false"/>
                        </VBox>

                        <!-- Senha com indicador de força -->
                        <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="6">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;"
                                   text="Senha"/>
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 8;                               -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 2;                               -fx-padding: 12;">
                                <FontAwesomeIconView glyphName="LOCK" size="16" style="-fx-fill: #64748b;"/>
                                <PasswordField fx:id="passwordField" maxWidth="Infinity"
                                               promptText="Digite uma senha segura"
                                               style="-fx-background-color: transparent; -fx-padding: 0;                                            -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8;"
                                               HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <!-- Indicador de força da senha melhorado -->
                            <VBox maxWidth="Infinity" spacing="4">
                                <ProgressBar fx:id="passwordStrengthBar" maxWidth="Infinity" progress="0.0"
                                             style="-fx-pref-height: 4; -fx-background-color: #e2e8f0; -fx-background-radius: 2;"
                                             styleClass="password-strength-bar"/>
                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: 500;"
                                           text="Força da senha:"/>
                                    <Label fx:id="passwordStrengthLabel"
                                           style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"
                                           text="Digite uma senha"/>
                                </HBox>
                            </VBox>
                            <Label fx:id="passwordErrorLabel" managed="false"
                                   style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-padding: 0 4;"
                                   visible="false"/>
                        </VBox>

                        <!-- Confirmar Senha -->
                        <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="6">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;"
                                   text="Confirmar Senha"/>
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 8;                               -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 2;                               -fx-padding: 12;">
                                <FontAwesomeIconView glyphName="SHIELD" size="16" style="-fx-fill: #64748b;"/>
                                <PasswordField fx:id="confirmPasswordField" maxWidth="Infinity"
                                               promptText="Confirme sua senha"
                                               style="-fx-background-color: transparent; -fx-padding: 0;                                            -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8;"
                                               HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Label fx:id="confirmPasswordErrorLabel" managed="false"
                                   style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-padding: 0 4;"
                                   visible="false"/>
                        </VBox>

                        <!-- Mensagem de erro modernizada -->
                        <VBox fx:id="errorContainer" managed="false" maxWidth="Infinity"
                              style="-fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-padding: 12;                           -fx-border-color: #fecaca; -fx-border-width: 1; -fx-border-radius: 8;"
                              visible="false">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <FontAwesomeIconView glyphName="EXCLAMATION_TRIANGLE" size="14"
                                                     style="-fx-fill: #ef4444;"/>
                                <Label fx:id="errorLabel" style="-fx-text-fill: #dc2626; -fx-font-size: 13px;"
                                       wrapText="true"/>
                            </HBox>
                        </VBox>

                        <!-- Mensagem de sucesso modernizada -->
                        <VBox fx:id="successContainer" managed="false" maxWidth="Infinity"
                              style="-fx-background-color: #f0fdf4; -fx-background-radius: 8; -fx-padding: 12;                           -fx-border-color: #bbf7d0; -fx-border-width: 1; -fx-border-radius: 8;"
                              visible="false">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <FontAwesomeIconView glyphName="CHECK_CIRCLE" size="14" style="-fx-fill: #059669;"/>
                                <Label fx:id="successLabel" style="-fx-text-fill: #059669; -fx-font-size: 13px;"
                                       wrapText="true"/>
                            </HBox>
                        </VBox>

                        <!-- Botão Cadastrar modernizado -->
                        <Button defaultButton="true" maxWidth="Infinity" onAction="#handleRegister"
                                style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold;                             -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 8;                             -fx-border-radius: 8; -fx-cursor: hand;">
                            <graphic>
                                <HBox alignment="CENTER" spacing="8">
                                    <FontAwesomeIconView glyphName="USER_PLUS" size="16" style="-fx-fill: white;"/>
                                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"
                                           text="Criar Conta"/>
                                </HBox>
                            </graphic>
                        </Button>

                        <!-- Link Login centralizado -->
                        <HBox alignment="CENTER" maxWidth="Infinity" spacing="6" style="-fx-padding: 16 0 0 0;">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Já tem uma conta?"/>
                            <Hyperlink onAction="#handleBack"
                                       style="-fx-text-fill: #4f46e5; -fx-underline: false; -fx-font-weight: 600;                                    -fx-font-size: 14px;"
                                       text="Faça login"/>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
        </content>
    </ScrollPane>

</StackPane>
