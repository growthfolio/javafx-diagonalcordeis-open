<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.diagonal.cordeis.controller.ColecaoController">
    
    <!-- HEADER SECTION -->
    <top>
        <VBox>
            <ToolBar style="-fx-background-color: none; -fx-padding: 10;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontAwesomeIconView fill="#9C27B0" glyphName="FOLDER" size="20" />
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Gerenciar Coleções" />
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #666; -fx-font-style: italic;" text="Organize livros em coleções temáticas" />
            </ToolBar>
            
            <!-- HELP BANNER -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 15 5 15; -fx-background-color: #F3E5F5; -fx-border-color: #9C27B0; -fx-border-width: 0 0 0 3;">
                <FontAwesomeIconView fill="#7B1FA2" glyphName="INFO_CIRCLE" size="12" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4A148C;" text="Cada coleção deve ter um SKU único e pelo menos um livro selecionado" />
            </HBox>
        </VBox>
    </top>
    
    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">
            
            <!-- LEFT PANEL: FORM -->
            <VBox prefWidth="400" spacing="20" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 20;">
                
                <!-- FORM HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontAwesomeIconView fill="#9C27B0" glyphName="PLUS_CIRCLE" size="16" />
                    <Label fx:id="labelFormulario" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Cadastro de Coleção" />
                </HBox>
                
                <!-- FORM FIELDS -->
                <VBox spacing="15">
                    
                    <!-- SKU -->
                    <VBox spacing="5">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="SKU da Coleção" />
                        <HBox spacing="8">
                            <TextField fx:id="skuField" prefHeight="35" prefWidth="280" promptText="Ex: COL0001" style="-fx-background-radius: 5; -fx-border-radius: 5;" />
                            <Button fx:id="btnGerarSku" onAction="#gerarSku" prefHeight="35" style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;">
                                <graphic>
                                    <FontAwesomeIconView fill="white" glyphName="MAGIC" size="14" />
                                </graphic>
                                <tooltip>
                                    <Tooltip text="Gerar SKU automaticamente" />
                                </tooltip>
                            </Button>
                        </HBox>
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #999;" text="🔢 Formato: COL0001, COL0002, etc." />
                    </VBox>
                    
                    <!-- NOME -->
                    <VBox spacing="5">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Nome da Coleção" />
                        <TextField fx:id="nomeField" prefHeight="35" prefWidth="360" promptText="Ex: Literatura de Cordel, Histórias Infantis..." style="-fx-background-radius: 5; -fx-border-radius: 5;" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #999;" text="📚 Nome descritivo para identificar a coleção" />
                    </VBox>
                    
                    <!-- TIPO -->
                    <VBox spacing="5">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Tipo de Coleção" />
                        <ComboBox fx:id="comboTipoColecao" prefHeight="35" prefWidth="200" promptText="Selecione o tipo..." style="-fx-background-radius: 5;" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #999;" text="🏷️ Categoria da coleção (Normal, Mini, Especial)" />
                    </VBox>
                    
                    <!-- SELEÇÃO DE LIVROS -->
                    <VBox spacing="5">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Livros da Coleção" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Button fx:id="btnAbrirSelecaoLivros" onAction="#abrirModalSelecaoLivros" prefHeight="35" prefWidth="200" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Selecionar Livros">
                                <graphic>
                                    <FontAwesomeIconView fill="white" glyphName="BOOK" size="14" />
                                </graphic>
                                <tooltip>
                                    <Tooltip text="Abrir modal para selecionar livros" />
                                </tooltip>
                            </Button>
                        </HBox>
                        
                        <!-- PREVIEW DOS LIVROS -->
                        <ScrollPane fx:id="scrollPreviewLivros" prefHeight="120" style="-fx-background-color: #F8F9FA; -fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-border-width: 1;">
                            <VBox fx:id="containerPreviewLivros" spacing="3" style="-fx-padding: 8;">
                                <Label maxWidth="Infinity" style="-fx-font-size: 10px; -fx-text-fill: #666; -fx-font-style: italic;" text="👆 Clique em 'Selecionar Livros' para escolher os livros desta coleção" />
                            </VBox>
                        </ScrollPane>
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #999;" text="📖 Preview dos livros selecionados para a coleção" />
                    </VBox>
                </VBox>
                
                <!-- ACTION BUTTONS -->
                <VBox spacing="10">
                    <Separator />
                    
                    <!-- PRIMARY ACTIONS -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button fx:id="btnSalvar" onAction="#salvarColecao" prefHeight="35" prefWidth="120" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Salvar">
                            <graphic>
                                <FontAwesomeIconView fill="white" glyphName="FLOPPY_O" size="14" />
                            </graphic>
                            <tooltip>
                                <Tooltip text="Salvar nova coleção ou atualizar selecionada" />
                            </tooltip>
                        </Button>
                        
                        <Button fx:id="btnLimpar" onAction="#limparFormulario" prefHeight="35" prefWidth="100" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-background-radius: 5;" text="Limpar">
                            <graphic>
                                <FontAwesomeIconView fill="white" glyphName="ERASER" size="14" />
                            </graphic>
                            <tooltip>
                                <Tooltip text="Limpar formulário" />
                            </tooltip>
                        </Button>
                    </HBox>
                    
                    <!-- HELP TEXT -->
                    <VBox spacing="5" style="-fx-background-color: #f3e5f5; -fx-background-radius: 5; -fx-padding: 10;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #7B1FA2;" text="📋 Passos para criar uma coleção:" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #424242;" text="• Preencha SKU, nome e tipo da coleção" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #424242;" text="• Clique em 'Selecionar Livros' para escolher os livros" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #424242;" text="• Revise o preview e clique em 'Salvar'" />
                    </VBox>
                </VBox>
            </VBox>
            
            <!-- RIGHT PANEL: TABLE -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            <VBox>
               <children>
                      <!-- TABLE HEADER -->
                      <HBox alignment="CENTER_LEFT" spacing="8" />
                      <!-- BARRA DE BUSCA -->
                      <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-container">
                     <VBox>
                        <children>
                           <ToolBar style="-fx-background-color: transparent;">
                              <items>
                                      <FontAwesomeIconView fill="#666" glyphName="LIST" size="16" />
                                      <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Coleções Cadastradas" />
                                      <Region prefHeight="24.0" prefWidth="60.0" />
                                      <Label fx:id="labelResultadosColecoes" prefHeight="24.0" prefWidth="85.0" styleClass="results-counter" text="0 coleções" />
                              </items>
                           </ToolBar>
                           <ToolBar style="-fx-background-color: transparent;">
                              <items>
                                      <FontAwesomeIconView fill="#666" glyphName="SEARCH" size="14" />
                                      <TextField fx:id="campoBuscaColecoes" prefHeight="26.0" prefWidth="315.0" promptText="Buscar por nome da coleção ou SKU..." styleClass="table-search-field" />
                                      <Button fx:id="btnLimparBuscaColecoes" onAction="#limparBuscaColecoes" styleClass="clear-search-button" text="✖">
                                          <tooltip>
                                              <Tooltip text="Limpar busca" />
                                          </tooltip>
                                      </Button>
                              </items>
                           </ToolBar>
                        </children>
                     </VBox>
                      </HBox>
               </children>
            </VBox>
                
                <!-- TABLE -->
                <TableView fx:id="tabelaColecoes" style="-fx-background-radius: 5; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSku" prefWidth="100" text="SKU" />
                        <TableColumn fx:id="colNome" prefWidth="200" text="Nome da Coleção" />
                        <TableColumn fx:id="colQuantidade" prefWidth="60" text="Qtd." />
                        <TableColumn fx:id="colLivros" prefWidth="250" text="Livros da Coleção" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                            <FontAwesomeIconView fill="#ccc" glyphName="FOLDER_OPEN_O" size="48" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #999;" text="Nenhuma coleção cadastrada" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #ccc;" text="Crie a primeira coleção usando o formulário ao lado" />
                        </VBox>
                    </placeholder>
                </TableView>
                
                <!-- TABLE ACTIONS -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="btnEditarColecao" onAction="#editarColecao" prefHeight="35" prefWidth="100" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Editar">
                        <graphic>
                            <FontAwesomeIconView fill="white" glyphName="EDIT" size="14" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Editar coleção selecionada" />
                        </tooltip>
                    </Button>
                    
                    <Button fx:id="btnExcluirColecao" onAction="#excluirColecao" prefHeight="35" prefWidth="100" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Excluir">
                        <graphic>
                            <FontAwesomeIconView fill="white" glyphName="TRASH" size="14" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Excluir coleção selecionada" />
                        </tooltip>
                    </Button>
                </HBox>
                
                <!-- TABLE FOOTER INFO -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f9f9f9; -fx-background-radius: 5; -fx-padding: 8;">
                    <FontAwesomeIconView fill="#666" glyphName="INFO_CIRCLE" size="12" />
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #666;" text="Clique em uma linha para editar • Duplo clique no nome/SKU para editar diretamente • Duplo clique para visualizar detalhes" />
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
